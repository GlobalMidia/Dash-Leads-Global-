# Mantém uma publicação de aprovação aberta, isolada e apenas demonstrativa.
# Quando true, ignora banco, credenciais do painel e integrações reais.
PUBLIC_PROTOTYPE=false

# Banco Postgres (recomendado: Neon pela Vercel Marketplace)
DATABASE_URL=

# Proteção obrigatória quando houver dados reais
# Login individual via Neon Auth. Use a mesma chave longa em Produção e Pré-visualização.
DATABASE_NEON_AUTH_BASE_URL=
NEON_AUTH_COOKIE_SECRET=

# Legado temporário: senha compartilhada, mantida somente durante a transição.
DASHBOARD_PASSWORD=
DASHBOARD_SESSION_SECRET=

# RD Station Marketing — OAuth2
# RD_ACCESS_TOKEN pode ser usado em um teste curto (expira em 24 horas).
RD_ACCESS_TOKEN=
RD_CLIENT_ID=
RD_CLIENT_SECRET=
RD_REFRESH_TOKEN=

# Segredo longo usado no final da URL do webhook:
# https://seu-dominio.vercel.app/api/rd/webhook?token=SEU_SEGREDO
RD_WEBHOOK_SECRET=
